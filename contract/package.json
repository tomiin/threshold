{
  "name": "@tomiin/threshold-contract",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "compact": "compact compile src/threshold.compact src/managed/threshold",
    "compact-fast": "compact compile --skip-zk src/threshold.compact src/managed/threshold",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:compile": "npm run compact-fast && vitest run",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -Rf ./src/managed ./dist/managed && cp ./src/threshold.compact ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}